    "src",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agentrail-co/agentrail-skills.git"
  },
  "homepage": "https://github.com/agentrail-co/agentrail-skills#readme",
